# Copy to .env on the mother host.

MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
TOTAL_LAYERS=22

# Petals bootstrap multiaddr (filled after shard manager / Petals starts)
INITIAL_PEERS=

API_HOST=0.0.0.0
API_PORT=8000
MOTHER_SHARD_MANAGER_URL=http://127.0.0.1:8001

DEFAULT_MAX_TOKENS=256
HARD_MAX_TOKENS=512
LOAD_AT_STARTUP=1
HEARTBEAT_TTL_SECONDS=180
