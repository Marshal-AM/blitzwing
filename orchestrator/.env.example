# Copy to .env on the mother host (or use repo-root .env).

MODEL_NAME=HuggingFaceTB/SmolLM2-360M-Instruct
TOTAL_LAYERS=32

# Petals bootstrap multiaddr (filled after shard manager / Petals starts)
INITIAL_PEERS=

API_HOST=0.0.0.0
API_PORT=8000
MOTHER_SHARD_MANAGER_URL=http://127.0.0.1:8001

DEFAULT_MAX_TOKENS=256
HARD_MAX_TOKENS=512
LOAD_AT_STARTUP=1
HEARTBEAT_TTL_SECONDS=180

# --- x402 / Hedera payouts ---
X402_ENABLED=1
COST_PER_LAYER_TINYBARS=10000000
MOTHER_ACCOUNT_ID=
MOTHER_PRIVATE_KEY=
FACILITATOR_URL=http://127.0.0.1:8791
FACILITATOR_ACCOUNT_ID=
FACILITATOR_PRIVATE_KEY=
FACILITATOR_PORT=8791
HEDERA_NETWORK=hedera-testnet
# Optional; created automatically on first boot if empty
HCS_TOPIC_ID=
